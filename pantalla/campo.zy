// ============================================================
// pantalla/campo.zy — leer datos dentro del modo crudo
//
// En modo crudo `<<|` entrega UNA tecla. Un campo de entrada hay
// que construirlo: acumular, borrar, redibujar y decidir cuándo se
// ha terminado. Esto es ese campo.
//
// LA VALIDACIÓN ES POR TECLA, NO AL CONFIRMAR. Un campo de importe
// no acepta una letra: sencillamente no la escribe. Y el punto
// decimal no se acepta «si el texto queda bien» — se acepta si la
// MONEDA tiene decimales. En pesos chilenos (exponente 0) la tecla
// del punto no hace nada, porque en pesos chilenos no hay nada
// que poner detrás del punto; en dólares se admite uno y hasta dos
// dígitos tras él; en dinares kuwaitíes, tres.
//
// Esa es la diferencia entre validar la entrada y corregir el
// error después: aquí no hay error que corregir, porque el estado
// inválido nunca llega a existir. Y el usuario ve el importe
// formateado en su moneda mientras teclea, así que sabe en todo
// momento qué está escribiendo — «1234» en un campo CLP se lee
// «$1.234» y en uno USD «$12.34», con la misma pulsación.
//
// EN: pantalla/campo.zy — reading data inside raw mode. `<<|` gives
// one key; a field has to be built. VALIDATION IS PER KEYSTROKE,
// NOT ON CONFIRM: an amount field does not accept a letter — it
// simply does not type it — and the decimal point is accepted
// because the CURRENCY has decimals, not because the text would
// come out well. In CLP (exponent 0) the point key does nothing;
// USD takes two digits after it, KWD three. The live preview shows
// the amount formatted in its currency as it is typed.
// ============================================================

# .pantalla_campo {

    <# ./teclas => k
    <# ../núcleo/dinero => din
    <# std/term => tm

    #> { número, fecha, texto, confirmar, elegir }

    ETIQUETA := 250
    ENTRADA  := 231
    VISTA    := 45
    AVISO    := 203

    _limpiar(fila, col, ancho) {
        blanco = ""
        i = 1
        @ i <= ancho {
            blanco = °blanco " "
            i++
        }
        >>~ (fila, col) > blanco
    }

    // Cuántos dígitos hay ya después del separador decimal.
    // Devuelve -1 si todavía no hay separador.
    // EN: how many digits are already past the decimal separator;
    // -1 when there is none yet.
    _decimales(crudo) {
        pos = 0
        i = 1
        @ i <= crudo$# {
            ? crudo$[i..i] == "." { pos = i }
            i++
        }
        ? pos == 0 { <~ 0 - 1 }
        <~ crudo$# - pos
    }

    // ── El campo de importe ──────────────────────────────────
    //
    // Devuelve (confirmado, importe_entero). El importe sale ya en la
    // unidad menor de la moneda: quien lo recibe no vuelve a
    // interpretar el texto, porque el texto no sale de aquí.
    //
    // EN: returns (confirmed, integer amount) already in the
    // currency's minor unit — the text never leaves this function.
    número(fila, col, ancho, moneda, etiqueta) {
        exp = moneda["exponente"]
        crudo = ""
        vivo = #1
        confirmado = #0

        @ vivo {
            _limpiar(fila, col, ancho + 24)
            >>~ (fila, col, 0, ETIQUETA, 0) > etiqueta
            // Se guarda en ASCII y se PINTA en la escritura activa.
            // Quien teclea «१२» en un teclado hindi ve «१२»; quien
            // teclea «12» con el idioma en hindi también, porque lo
            // que manda es la escritura del idioma elegido, igual
            // que para el saldo y para la vista previa. El crudo no
            // sale nunca de aquí, así que la aritmética se hace
            // siempre sobre ASCII y nunca sobre lo que se tecleó.
            //
            // EN: stored in ASCII, PAINTED in the active script.
            // Someone typing «१२» on a Hindi keyboard sees «१२»; so
            // does someone typing «12» with the locale in Hindi,
            // because what rules is the script of the chosen locale,
            // as for the balance and the preview. The raw string
            // never leaves, so arithmetic is always over ASCII.
            marca = k::transliterar(crudo) "_"
            >>~ (fila, col + tm::width(etiqueta) + 1, 1, ENTRADA, 0) > marca

            // La vista previa: el mismo entero que se guardará,
            // escrito como lo lee una persona.
            // EN: the preview is the very integer that will be
            // stored, written as a person reads it.
            (válido, valor) = din::analizar(crudo, moneda)
            ? válido {
                >>~ (fila, col + tm::width(etiqueta) + ancho + 3, 0, VISTA, 0) > din::formatear(valor, moneda)
            }

            <<| t

            ? k::es_entrar(t) {
                ? válido {
                    confirmado = #1
                    vivo = #0
                }
            }
            _? k::es_escapar(t) {
                vivo = #0
            }
            _? k::es_borrar(t) {
                ? crudo$# > 0 { crudo = crudo$-[crudo$#] }
            }
            _? k::es_dígito(t) {
                // El límite de decimales es el de la MONEDA, y el
                // ancho del campo el del campo. Ni uno ni otro
                // dejan escribir de más.
                //
                // Se guarda el VALOR del dígito, no la tecla: «७»
                // entra como "7". Así una misma cuenta admite que
                // hoy se teclee en devanagari y mañana en ASCII, y
                // el número guardado es el mismo.
                // EN: the digit's VALUE is stored, not the key: «७»
                // enters as "7", so the same account takes Devanagari
                // today and ASCII tomorrow and stores one number.
                d = _decimales(crudo)
                cabe = crudo$# < ancho
                ? d >= exp { cabe = #0 }
                ? cabe { crudo = crudo k::dígito_ascii(t) }
            }
            _? k::es_separador(t) {
                // Un separador solo si la moneda tiene decimales, y
                // solo uno. En CLP esta tecla no hace nada, que es
                // exactamente lo que debe hacer.
                // EN: a separator only if the currency has decimals,
                // and only one. In CLP this key does nothing.
                ? exp > 0 {
                    ? _decimales(crudo) < 0 {
                        ? crudo$# == 0 { crudo = "0." }
                        _ { crudo = crudo "." }
                    }
                }
            }
        }

        _limpiar(fila, col, ancho + 24)
        ? confirmado {
            (_v, valor) = din::analizar(crudo, moneda)
            <~ (#1, valor)
        }
        <~ (#0, 0)
    }

    // ── El campo de fecha ────────────────────────────────────
    //
    // Misma doctrina que el campo de importe: se teclean DÍGITOS y
    // los guiones los pone el campo. No hay forma de escribir
    // «2026-08-2100» porque no hay forma de escribir un guion ni un
    // undécimo dígito — el estado inválido no llega a existir, en
    // vez de detectarse al confirmar.
    //
    // Y ENTER no confirma una fecha que no es una fecha. Ocho
    // dígitos bien colocados siguen pudiendo decir «2026-02-31», y
    // eso no es un día: es una cadena con forma de día. Un libro de
    // cuentas ordena por fecha y resume por periodo, así que una
    // fecha que no existe no desordena la pantalla, desordena el
    // dinero.
    //
    // Los dígitos entran en CUALQUIERA de las trece escrituras, por
    // lo mismo que en el importe: un teclado hindi manda «२» y eso
    // es un dos. Se guarda el valor y se pinta en la escritura del
    // idioma activo.
    //
    // EN: same doctrine as the amount field — DIGITS are typed and
    // the field puts the dashes. "2026-08-2100" cannot be written
    // because neither a dash nor an eleventh digit can be. And ENTER
    // does not confirm a date that is not one: eight well-placed
    // digits can still spell "2026-02-31", which is a string shaped
    // like a day. A ledger sorts by date and summarises by period,
    // so a date that does not exist does not disarrange the screen,
    // it disarranges the money. Digits are taken in any of the
    // thirteen scripts.

    // Un texto de dígitos ASCII a su número. `###` no toma texto y
    // `##!` quiere un Char, mientras que un trozo de cadena es una
    // cadena: la vuelta es la misma que da `teclas::transliterar`,
    // comparar contra la tabla y quedarse con la posición.
    // EN: a string of ASCII digits to its number. `###` does not
    // take text and `##!` wants a Char, while a slice is a String;
    // the way round is the one `teclas::transliterar` already takes.
    _entero(texto) {
        ascii = "0123456789"
        n = 0
        i = 1
        @ i <= texto$# {
            c = texto$[i..i]
            j = 1
            @ j <= 10 {
                ? c == ascii$[j..j] { n = °n * 10 + (j - 1) }
                j++
            }
            i++
        }
        <~ n
    }

    _bisiesto(a) {
        ? a % 400 == 0 { <~ #1 }
        ? a % 100 == 0 { <~ #0 }
        <~ a % 4 == 0
    }

    _días_del_mes(a, m) {
        ? m == 2 {
            ? _bisiesto(a) { <~ 29 }
            <~ 28
        }
        ? m == 4  { <~ 30 }
        ? m == 6  { <~ 30 }
        ? m == 9  { <~ 30 }
        ? m == 11 { <~ 30 }
        <~ 31
    }

    // (válida, "AAAA-MM-DD") a partir de los ocho dígitos crudos.
    // EN: (valid, "YYYY-MM-DD") from the eight raw digits.
    _armar_fecha(crudo) {
        ? crudo$# < 8 { <~ (#0, "") }
        sa = crudo$[1..4]
        sm = crudo$[5..6]
        sd = crudo$[7..8]
        a = _entero(sa)
        m = _entero(sm)
        d = _entero(sd)
        ? m < 1  { <~ (#0, "") }
        ? m > 12 { <~ (#0, "") }
        ? d < 1  { <~ (#0, "") }
        ? d > _días_del_mes(a, m) { <~ (#0, "") }
        <~ (#1, sa "-" sm "-" sd)
    }

    // Lo tecleado, con los guiones puestos y el hueco a la vista.
    // EN: what was typed, with the dashes in and the gap visible.
    _pintar_fecha(crudo) {
        molde = "AAAA-MM-DD"
        salida = ""
        i = 1
        j = 1
        @ i <= 10 {
            trozo = molde$[i..i]
            ? trozo == "-" { salida = °salida "-" }
            _ {
                ? j <= crudo$# {
                    salida = °salida crudo$[j..j]
                }
                _ { salida = °salida "_" }
                j = °j + 1
            }
            i++
        }
        <~ salida
    }

    fecha(fila, col, etiqueta, inicial) {
        // La fecha que llega se descompone en sus ocho dígitos: el
        // campo solo conoce dígitos, así que lo propuesto entra por
        // la misma puerta que lo tecleado y los guiones se caen
        // solos.
        //
        // Se compara contra la tabla ASCII en vez de llamar a
        // `teclas::es_dígito`, que quiere un Char: un trozo de
        // cadena es una CADENA, y `##!` la rechaza. Lo que llega
        // aquí siempre es ASCII —`al::hoy()` fuerza `#09#`— así que
        // la tabla basta.
        //
        // EN: the incoming date is broken into its eight digits, so
        // what is proposed comes in through the same door as what is
        // typed. Compared against the ASCII table rather than
        // calling `teclas::es_dígito`, which wants a Char: a slice
        // is a STRING and `##!` refuses it.
        ascii = "0123456789"
        crudo = ""
        i = 1
        @ i <= inicial$# {
            c = inicial$[i..i]
            j = 1
            @ j <= 10 {
                ? c == ascii$[j..j] { crudo = °crudo c }
                j++
            }
            i++
        }
        ? crudo$# > 8 { crudo = crudo$[1..8] }

        vivo = #1
        confirmado = #0
        salida = ""

        @ vivo {
            _limpiar(fila, col, 40)
            >>~ (fila, col, 0, ETIQUETA, 0) > etiqueta
            marca = k::transliterar(_pintar_fecha(crudo))
            >>~ (fila, col + tm::width(etiqueta) + 1, 1, ENTRADA, 0) > marca

            (válida, texto_fecha) = _armar_fecha(crudo)
            ? !válida {
                ? crudo$# == 8 {
                    >>~ (fila, col + tm::width(etiqueta) + 14, 0, AVISO, 0) > "✗"
                }
            }

            <<| t

            ? k::es_entrar(t) {
                ? válida {
                    salida = texto_fecha
                    confirmado = #1
                    vivo = #0
                }
            }
            _? k::es_escapar(t) {
                vivo = #0
            }
            _? k::es_borrar(t) {
                ? crudo$# > 0 { crudo = crudo$-[crudo$#] }
            }
            _? k::es_dígito(t) {
                ? crudo$# < 8 { crudo = crudo k::dígito_ascii(t) }
            }
        }

        _limpiar(fila, col, 40)
        ? confirmado { <~ (#1, salida) }
        <~ (#0, inicial)
    }

    // ── El campo de texto ────────────────────────────────────
    //
    // Para glosas y nombres. Acepta cualquier carácter imprimible,
    // que aquí incluye acentos, kana y devanagari: `<<|` entrega
    // graphemes completos, así que «ñ» llega en una sola lectura y
    // no en dos bytes.
    //
    // EN: for notes and names. Accepts any printable character,
    // accents, kana and Devanagari included: `<<|` delivers whole
    // graphemes, so «ñ» arrives in one read, not two bytes.
    texto(fila, col, ancho, etiqueta, inicial) {
        crudo = inicial
        vivo = #1
        confirmado = #0

        @ vivo {
            _limpiar(fila, col, ancho + 24)
            >>~ (fila, col, 0, ETIQUETA, 0) > etiqueta
            marca = crudo "_"
            >>~ (fila, col + tm::width(etiqueta) + 1, 1, ENTRADA, 0) > marca

            <<| t

            ? k::es_entrar(t) {
                confirmado = #1
                vivo = #0
            }
            _? k::es_escapar(t) {
                vivo = #0
            }
            _? k::es_borrar(t) {
                ? crudo$# > 0 { crudo = crudo$-[crudo$#] }
            }
            _? k::es_flecha(t) {
                // Una flecha no se escribe. El campo acepta
                // «cualquier carácter imprimible» y una flecha llega
                // como uno —'←' es un carácter—, así que sin esta
                // rama pulsarla metería la punta de flecha en la
                // glosa. No mueve el cursor porque este campo no
                // tiene cursor que mover: se escribe y se borra por
                // el final.
                // EN: an arrow is not typed. The field takes "any
                // printable character" and an arrow arrives as one,
                // so without this branch pressing it would put the
                // arrowhead into the note. It does not move a cursor
                // because this field has none: it is written and
                // erased from the end.
            }
            _ {
                // Se mide en COLUMNAS y no en caracteres: «食費»
                // ocupa cuatro columnas del campo, no dos.
                // EN: measured in COLUMNS, not characters.
                nuevo = crudo "" t
                ? tm::width(nuevo) <= ancho { crudo = nuevo }
            }
        }

        _limpiar(fila, col, ancho + 24)
        ? confirmado { <~ (#1, crudo) }
        <~ (#0, inicial)
    }

    // ── Elegir de una lista ──────────────────────────────────
    //
    // ↑↓ o `j`/`k` mueven, ENTER o → elige, ESC o ← cancela.
    //
    // Las flechas se aceptan porque `<<|` las entrega ya decodificadas
    // y un ESC suelto sigue distinguiéndose (ver `pantalla/teclas`).
    // `j`/`k` se quedan: quien viene de `vi` no tiene por qué soltar
    // la fila de inicio, y las dos formas no se estorban.
    //
    // EN: ↑↓ or `j`/`k` move, ENTER or → picks, ESC or ← cancels.
    // The arrows are taken because `<<|` hands them over decoded and
    // a bare ESC is still told apart (see `pantalla/teclas`). `j`/`k`
    // stay: whoever comes from `vi` need not leave the home row.
    elegir(fila, col, ancho, opciones, etiqueta) {
        sel = 1
        vivo = #1
        confirmado = #0

        @ vivo {
            >>~ (fila, col, 0, ETIQUETA, 0) > etiqueta
            i = 1
            @ i <= opciones$# {
                _limpiar(fila + i, col, ancho + 4)
                estilo = 0
                color = ETIQUETA
                marca = "  "
                ? i == sel {
                    estilo = 1
                    color = ENTRADA
                    marca = "▸ "
                }
                >>~ (fila + i, col, estilo, color, 0) > marca opciones[i]
                i++
            }

            <<| t

            ? k::es_entrar(t) || k::es_derecha(t) {
                confirmado = #1
                vivo = #0
            }
            _? k::es_escapar(t) || k::es_izquierda(t) {
                vivo = #0
            }
            _? t == 'j' || k::es_abajo(t) {
                ? sel < opciones$# { sel++ }
            }
            _? t == 'k' || k::es_arriba(t) {
                ? sel > 1 { sel-- }
            }
        }

        i = 0
        @ i <= opciones$# {
            _limpiar(fila + i, col, ancho + 4)
            i++
        }
        ? confirmado { <~ (#1, sel) }
        <~ (#0, 0)
    }

    // Sí/no. `s` y `y` valen que sí, porque la aplicación habla
    // cuatro idiomas y la tecla no se traduce.
    // EN: yes/no. Both `s` and `y` mean yes — the application speaks
    // four languages and the key is not translated.
    confirmar(fila, col, pregunta) {
        _limpiar(fila, col, tm::width(pregunta) + 12)
        >>~ (fila, col, 1, AVISO, 0) > pregunta " [s/n]"
        respuesta = #0
        vivo = #1
        @ vivo {
            <<| t
            ? t == 's' || t == 'S' || t == 'y' || t == 'Y' {
                respuesta = #1
                vivo = #0
            }
            _? t == 'n' || t == 'N' || k::es_escapar(t) || k::es_entrar(t) {
                respuesta = #0
                vivo = #0
            }
        }
        _limpiar(fila, col, tm::width(pregunta) + 12)
        <~ respuesta
    }
}
