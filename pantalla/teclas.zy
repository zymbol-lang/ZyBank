// ============================================================
// pantalla/teclas.zy — las teclas de control y los dígitos que no
//                       son ASCII
//
// Dos problemas distintos, los dos de la misma naturaleza, y los
// dos resueltos por lo mismo: un carácter ES un número en cuanto se
// le pide su punto de código con `##!`.
//
// ── 1. Las teclas de control ─────────────────────────────────
//
// Un campo de entrada necesita ENTER para confirmar, RETROCESO para
// corregir y ESC para cancelar. En un literal entre comillas simples
// las únicas secuencias de escape son \n \t \r \" \\ \{ \} — no
// existe \e ni \xNN — pero un carácter también se escribe por su
// código: `0x1b`, `0o33`, `0b11011` y `0d27` son todos ESC, y son
// literales de CARÁCTER, no enteros (`0d65 == 'A'` es `#1` y
// `0d65 == 65` es `#0`). GUIDE.md § "Literals".
//
// Aquí se usa la forma decimal, que es la que se lee igual que la
// tabla ASCII que uno tiene en la cabeza.
//
// ── 2. Los dígitos ───────────────────────────────────────────
//
// Un dígito no es `'0'`..`'9'`. Quien escribe hindi con una
// distribución InScript teclea «१२३», y en bengalí «১২৩»: el
// teclado manda U+0966 y U+09E6, no U+0030. Dar por hecho el ASCII
// es dar por hecho un teclado, y esta aplicación imprime
// «$१२,३४५.०७» en pantalla — aceptar solo ASCII sería localizar la
// salida y dejar la entrada sin localizar, que es peor que no
// localizar nada, porque enseña al usuario una escritura que luego
// le rechaza.
//
// Pero no hace falta saber qué carácter es: hace falta saber cuánto
// vale. Unicode coloca las diez cifras de cada escritura en diez
// puntos de código SEGUIDOS, así que restarle a `##!t` el cero de la
// escritura da el valor directamente. Lo único que hay que declarar
// es ese cero, y es un NÚMERO — algo que se comprueba de un vistazo,
// al contrario que un glifo que nadie de este equipo sabe leer.
//
// `pruebas/verificación_dígitos.zy` no comprueba que los ceros estén
// bien copiados: comprueba, contra el mode-switch del propio
// lenguaje, que sean los ceros que el lenguaje escribe Y que las
// diez cifras vayan seguidas — que es la premisa de la que depende
// la resta.
//
// EN: pantalla/teclas.zy — the control keys and the digits that are
// not ASCII. Both are one problem: a character IS a number the
// moment you ask for its code point with `##!`.
//
// A character can be written by its code — `0x1b`, `0o33`, `0b11011`
// and `0d27` are all ESC — and these are CHARACTER literals, not
// integers (`0d65 == 'A'` is `#1`, `0d65 == 65` is `#0`).
//
// A digit is not `'0'`..`'9'`: an InScript layout sends U+0966,
// Bengali U+09E6. Assuming ASCII assumes a keyboard, and this
// application prints «$१२,३४५.०७» on screen — accepting only ASCII
// would localise the output and leave the input unlocalised, which
// is worse than localising nothing, since it shows the user a script
// it then refuses. But what is needed is not which character it is,
// it is what it is worth: Unicode lays each script's ten digits in
// ten CONSECUTIVE code points, so `##!t` minus the script's zero is
// the value. Only that zero is declared, and it is a NUMBER — which
// can be checked at a glance, unlike a glyph nobody here reads.
// ============================================================

# .pantalla_teclas {

    #> {
        borrar
        escapar
        entrar
        es_borrar
        es_escapar
        es_entrar
        es_arriba
        es_abajo
        es_izquierda
        es_derecha
        es_flecha
        es_separador
        dígito_ascii
        es_dígito
        escrituras
        activa
        transliterar
    }

    // El retroceso del teclado envía DEL (0x7f) y llega como NUL
    // (0x00). El tabulador (0x09) llega TAMBIÉN como NUL: las dos
    // teclas colapsan en un mismo valor y son indistinguibles
    // (BUG-ZYB-006). En un campo numérico el tabulador no significa
    // nada, así que tratar ambas como «borrar» no pierde nada aquí
    // — un editor de texto de verdad no podría vivir con esto.
    //
    // EN: backspace sends DEL (0x7f) and arrives as NUL (0x00); Tab
    // (0x09) ALSO arrives as NUL. The two collapse into one value
    // (BUG-ZYB-006). In a numeric field Tab means nothing.
    borrar()  { <~ 0d0 }
    escapar() { <~ 0d27 }
    entrar()  { <~ '\n' }

    es_borrar(t)  { <~ t == 0d0 }
    es_escapar(t) { <~ t == 0d27 }
    es_entrar(t)  { <~ t == '\n' }

    // ── Las flechas ──────────────────────────────────────────
    //
    // Llegan DECODIFICADAS. El terminal manda tres bytes —ESC, '['
    // y una letra— y `<<|` los junta y entrega UN carácter: '↑',
    // '↓', '←' o '→'. Un ESC suelto sigue llegando como 0d27, así
    // que aceptar las flechas no cuesta la tecla de cancelar.
    //
    // Esto es lo que GAP-ZYB-011 daba por imposible, y lo daba
    // porque describía una versión del lenguaje que entregaba los
    // bytes crudos: sin un temporizador no había forma de saber si
    // un ESC empezaba una secuencia o era ESC. Hoy la separación la
    // hace el propio lenguaje. Comprobado con un pty de verdad,
    // tecla a tecla: ↑ es 8593, ↓ es 8595, ← es 8592, → es 8594 y
    // ESC sigue siendo 27.
    //
    // Se comparan contra el glifo y no contra el número, al revés
    // que los dígitos de más abajo: aquí el glifo ES legible —'↓'
    // se lee «abajo» sin consultar nada— y un 8595 no.
    //
    // EN: the arrows arrive DECODED. The terminal sends three bytes
    // — ESC, '[' and a letter — and `<<|` joins them into ONE
    // character: '↑', '↓', '←', '→'. A bare ESC still arrives as
    // 0d27, so taking the arrows does not cost the cancel key.
    // GAP-ZYB-011 called this impossible, describing a version of
    // the language that handed over the raw bytes. Verified through
    // a real pty, key by key. Compared against the glyph rather
    // than the number — unlike the digits below — because here the
    // glyph is the readable form and 8595 is not.
    es_arriba(t)     { <~ t == '↑' }
    es_abajo(t)      { <~ t == '↓' }
    es_izquierda(t)  { <~ t == '←' }
    es_derecha(t)    { <~ t == '→' }

    // Para un campo que acepta «cualquier carácter»: una flecha no
    // es un carácter que escribir, y sin esto se teclearía sola.
    // EN: for a field that accepts "any character" — an arrow is
    // not one to type, and without this it would type itself.
    es_flecha(t) {
        <~ es_arriba(t) || es_abajo(t) || es_izquierda(t) || es_derecha(t)
    }

    // El cero de cada escritura, como NÚMERO. Los nueve índicos son
    // 2406 + 128k porque cada bloque índico ocupa 128 puntos de
    // código: esto es una progresión, no una lista que copiar.
    //
    // Añadir una escritura es añadir su cero. El lenguaje conoce 69;
    // aquí están las que tienen teclado propio de uso real.
    //
    // EN: each script's zero, as a NUMBER. The nine Indic ones are
    // 2406 + 128k, since an Indic block is 128 code points wide — a
    // progression, not a list to copy. Adding a script is adding its
    // zero.
    escrituras() {
        <~ [
            ("ascii",       48),
            ("árabe",     1632),
            ("persa",     1776),
            ("devanagari", 2406),
            ("bengalí",    2534),
            ("gurmukhi",   2662),
            ("gujarati",   2790),
            ("oriya",      2918),
            ("tamil",      3046),
            ("telugu",     3174),
            ("kannada",    3302),
            ("malayalam",  3430),
            ("tailandés",  3664)
        ]
    }

    // El carácter tecleado → su dígito ASCII, o "" si no es un
    // dígito en ninguna escritura conocida. Es la validación que
    // pide un campo numérico, y es NUMÉRICA: no pregunta de qué
    // escritura viene, pregunta cuánto vale.
    //
    // EN: the typed character → its ASCII digit, or "" if it is not
    // a digit in any known script. This is the check a numeric field
    // needs, and it is NUMERIC: it does not ask which script the
    // character belongs to, it asks what it is worth.
    dígito_ascii(t) {
        punto = ##!t
        @ e:escrituras() {
            (_nombre, cero) = e
            valor = punto - cero
            ? valor >= 0 {
                ? valor <= 9 { <~ "0123456789"$[valor+1..valor+1] }
            }
        }
        <~ ""
    }

    es_dígito(t) { <~ dígito_ascii(t) <> "" }

    // El separador decimal también cambia de escritura: el árabe
    // usa U+066B (٫) y no el punto. La coma se acepta porque medio
    // mundo la usa como separador decimal y porque el teclado
    // numérico manda una u otro según la distribución.
    //
    // EN: the decimal separator changes script too — Arabic uses
    // U+066B (٫), not the point. The comma is accepted because half
    // the world writes decimals with it.
    es_separador(t) {
        <~ t == '.' || t == ',' || t == '٫'
    }

    // Los diez dígitos de la escritura ACTIVA, preguntándoselo al
    // propio lenguaje en vez de deducirlo del idioma: `"" 1234567890`
    // sale escrito en el modo numeral que haya puesto, sea cual sea,
    // así que esto sigue funcionando el día que se añada un idioma
    // con una escritura que este módulo no conoce.
    //
    // EN: the ten digits of the ACTIVE script, asked of the language
    // rather than deduced from the locale — `"" 1234567890` comes out
    // in whatever numeral mode is set, so this keeps working the day
    // a locale arrives with a script this module does not list.
    activa() {
        n = 1234567890
        d = "" n
        // Viene como 1,2,…,9,0; se reordena a 0..9.
        // EN: arrives as 1,2,…,9,0; reordered to 0..9.
        <~ d$[10..10] d$[1..9]
    }

    // Un texto de dígitos ASCII, escrito en la escritura activa.
    // Lo que no sea dígito (el separador decimal, el signo) pasa
    // sin tocar.
    // EN: a string of ASCII digits, written in the active script.
    // Anything else passes through untouched.
    transliterar(texto) {
        tabla = activa()
        ascii = "0123456789"
        salida = ""
        i = 1
        @ i <= texto$# {
            c = texto$[i..i]
            puesto = #0
            j = 1
            @ j <= 10 {
                ? c == ascii$[j..j] {
                    salida = °salida tabla$[j..j]
                    puesto = #1
                }
                j++
            }
            ? !puesto { salida = °salida c }
            i++
        }
        <~ salida
    }
}
