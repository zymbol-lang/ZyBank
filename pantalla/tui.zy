// ============================================================
// pantalla/tui.zy — la aplicación a pantalla completa
//
// Aquí se opera el libro de cuentas: se anotan movimientos, se
// corrigen, se borran, se abona y se descuenta saldo, y se abren
// cuentas. La CLI hace lo mismo escribiendo órdenes; la diferencia
// no es la comodidad, son dos cosas que solo existen aquí:
//
// 1. LA VALIDACIÓN OCURRE MIENTRAS SE TECLEA. Un campo de importe
//    no acepta una letra —no la escribe— y el punto decimal solo
//    entra si la moneda tiene decimales. En una orden de la CLI el
//    texto se valida cuando ya está escrito entero; aquí el estado
//    inválido nunca llega a existir. `pantalla/campo.zy` es eso.
//
// 2. EL IDIOMA CAMBIA EN VIVO. La tecla `i` rota el idioma y con él
//    se mueven las etiquetas, los nombres de las categorías y la
//    escritura de las cifras, sin recargar nada y sin que ninguna
//    función de dibujo sepa qué idioma hay puesto. En una orden
//    suelta el idioma se lee al arrancar y no vuelve a cambiar, así
//    que un despachador roto se vería igual que uno bueno.
//
// La disposición se mide con `>>?` en cada cuadro. Con la salida
// redirigida `>>?` devuelve (24, 80) en lugar de fallar, así que
// esto no revienta al tuberizarlo: se dibuja para 80 columnas.
//
// EN: pantalla/tui.zy — the full-screen application. Movements are
// recorded, corrected, deleted; balances credited and debited;
// accounts opened. Two things exist only here: validation happens
// WHILE TYPING (an amount field does not accept a letter, and the
// decimal point only enters if the currency has decimals), and the
// LOCALE CHANGES LIVE, digits included, with no drawing function
// aware of it.
// ============================================================

# .pantalla_tui {

    <# ../núcleo/almacén => al
    <# ../núcleo/dinero => din
    <# ../configuración/monedas => mon
    <# ../idioma/despacho => idi
    <# ../presentación/tabla => tab
    <# ./campo => cp
    <# ./teclas => k
    <# std/term => tm

    #> { correr }

    TÍTULO := 45
    TEXTO  := 252
    TENUE  := 244
    VERDE  := 46
    ROJO   := 203
    MARCA  := 226
    AVISO  := 214

    aviso = ""

    _rotar_idioma() {
        lista = idi::idiomas()
        actual = idi::actual()
        siguiente = lista[1]
        i = 1
        @ i <= lista$# {
            ? lista[i] == actual {
                ? i == lista$# { siguiente = lista[1] }
                _ { siguiente = lista[i + 1] }
            }
            i++
        }
        idi::fijar(siguiente)
    }

    // El importe se pinta con el color de su signo. Es la única
    // decisión de color con significado: un gasto en rojo se lee
    // antes que un signo menos.
    // EN: the only colour choice that carries meaning.
    _color_de(importe) {
        ? importe < 0 { <~ ROJO }
        <~ VERDE
    }

    _encabezado(ancho) {
        t = idi::texto("app.nombre") " · " idi::texto("app.lema")
        >>~ (1, 1, 1, TÍTULO, 0) > tm::center(t, ancho)
    }

    // El pie se RECORTA antes de centrarlo. `tm::center` no recorta
    // —devuelve la cadena entera cuando no cabe—, así que un pie más
    // largo que el terminal se derrama a la línea siguiente y empuja
    // la pantalla entera hacia arriba. No es hipotético: el pie de
    // cuentas ya medía 74 columnas en español y cada tecla nueva le
    // suma una docena, en cuatro idiomas de anchos distintos. Nadie
    // lo mide al añadir una tecla, así que se mide aquí.
    //
    // EN: the footer is TRUNCATED before centring. `tm::center` does
    // not truncate — it returns the whole string when it does not fit
    // — so a footer wider than the terminal spills onto the next line
    // and pushes the whole screen up. Not hypothetical: the accounts
    // footer already measured 74 columns in Spanish and every new key
    // adds a dozen, across four locales of different widths.
    _pie(fila, ancho, ayuda) {
        >>~ (fila, 1, 0, TENUE, 0) > tm::center(tm::truncate(ayuda, ancho), ancho)
    }

    _decir(fila, ancho) {
        ? aviso <> "" {
            >>~ (fila, 1, 1, AVISO, 0) > tm::center(aviso, ancho)
        }
    }

    // ── Cuentas ──────────────────────────────────────────────

    _pintar_cuentas(cuentas, sel, alto, ancho) {
        >>!
        _encabezado(ancho)
        ? cuentas$# == 0 {
            >>~ (3, 3, 0, TEXTO, 0) > idi::texto("msg.sin_cuentas")
        }
        _ {
            enc = [idi::texto("campo.cuenta"), idi::texto("campo.moneda"), idi::texto("campo.saldo")]
            filas = []
            saldos = []
            @ c:cuentas {
                m = mon::obtener(c.moneda)
                s = al::saldo(c.id)
                filas = °filas$+ [c.nombre, c.moneda, din::formatear(s, m)]
                saldos = °saldos$+ s
            }
            líneas = tab::componer(enc, filas, ["izq", "izq", "der"])
            fila = 3
            i = 1
            @ i <= líneas$# {
                estilo = 0
                color = TENUE
                marca = "  "
                ? i > 2 {
                    color = TEXTO
                    ? (i - 2) == sel {
                        estilo = 1
                        color = MARCA
                        marca = "▸ "
                    }
                }
                >>~ (fila, 3, estilo, color, 0) > marca líneas[i]
                fila++
                i++
            }
        }
        _decir(alto - 1, ancho)
        nue = idi::texto("acción.cuenta_nueva")
        mov = idi::texto("menú.movimientos")
        res = idi::texto("menú.resumen")
        tra = idi::texto("acción.traspasar")
        len = idi::nombre_idioma(idi::actual())
        sal = idi::texto("menú.salir")
        _pie(alto, ancho, "↑↓/jk ▸ ⏎/→ " mov " · c " nue " · t " tra " · r " res " · i " len " · q " sal)
    }

    _cuenta_nueva(alto, ancho) {
        >>!
        _encabezado(ancho)
        >>~ (3, 3, 1, TÍTULO, 0) > idi::texto("acción.cuenta_nueva")

        (ok1, nombre) = cp::texto(5, 3, 24, idi::texto("campo.nombre") ":", "")
        ? !ok1 { <~ #0 }
        ? nombre == "" { <~ #0 }

        códigos = mon::códigos()
        etiquetas = []
        @ c:códigos {
            m = mon::obtener(c)
            etiquetas = °etiquetas$+ (c "  " m["nombre"])
        }
        (ok2, cual) = cp::elegir(6, 3, 30, etiquetas, idi::texto("campo.moneda") ":")
        ? !ok2 { <~ #0 }
        código = códigos[cual]

        m = mon::obtener(código)
        (ok3, apertura) = cp::número(8, 3, 14, m, idi::texto("campo.saldo") ":")
        ? !ok3 { <~ #0 }

        // La fecha de la apertura se PREGUNTA, con hoy propuesto.
        // Una cuenta que se abrió hace años y se registra hoy con la
        // fecha de hoy deja su saldo de apertura fuera de cualquier
        // resumen de un periodo anterior — el dinero aparecería
        // apareciendo el día que alguien se sentó a teclearlo.
        //
        // Es un campo de FECHA, no uno de texto: se teclean dígitos,
        // los guiones los pone el campo y ENTER no confirma un
        // «2026-02-31». Un libro de cuentas ordena por fecha y
        // resume por periodo, así que una fecha que no existe no
        // desordena la pantalla, desordena el dinero.
        //
        // EN: the opening date is ASKED, with today proposed. An
        // account opened years ago and entered today with today's
        // date drops its opening balance out of every earlier period
        // summary. It is a DATE field, not a text one: digits are
        // typed, the field puts the dashes, and ENTER does not
        // confirm a "2026-02-31".
        (ok4, fecha) = cp::fecha(10, 3, idi::texto("campo.fecha") ":", al::hoy())
        ? !ok4 { <~ #0 }

        (creada, _id) = al::crear_cuenta(nombre, código, apertura, fecha)
        ? !creada {
            aviso = idi::texto("msg.importe_inválido")
            <~ #0
        }
        aviso = idi::texto("msg.cuenta_creada") ": " nombre " " din::formatear(apertura, m)
        <~ #1
    }

    // ── Movimientos ──────────────────────────────────────────

    _movs_de(cuenta, caben) {
        <~ al::movimientos(cuenta.id, caben)
    }

    _pintar_movimientos(cuenta, movs, sel, alto, ancho) {
        >>!
        _encabezado(ancho)
        m = mon::obtener(cuenta.moneda)
        >>~ (2, 3, 1, TÍTULO, 0) > cuenta.nombre "  " din::formatear(al::saldo(cuenta.id), m)

        ? movs$# == 0 {
            >>~ (4, 3, 0, TEXTO, 0) > idi::texto("msg.sin_movimientos")
        }
        _ {
            enc = [idi::texto("campo.fecha"), idi::texto("campo.categoría"),
                   idi::texto("campo.importe"), idi::texto("campo.glosa")]
            filas = []
            importes = []
            @ mv:movs {
                nombre_cat = ""
                ? al::es_nulo(mv.categoría) { nombre_cat = idi::texto("acción.traspasar") }
                _ { nombre_cat = idi::categoría(mv.categoría) }
                filas = °filas$+ [mv.fecha, nombre_cat, din::formatear(mv.importe, m), mv.glosa]
                importes = °importes$+ mv.importe
            }
            líneas = tab::componer(enc, filas, ["izq", "izq", "der", "izq"])
            fila = 4
            i = 1
            @ i <= líneas$# {
                color = TENUE
                estilo = 0
                marca = "  "
                ? i > 2 {
                    color = _color_de(importes[i - 2])
                    ? (i - 2) == sel {
                        estilo = 1
                        marca = "▸ "
                    }
                }
                >>~ (fila, 3, estilo, color, 0) > marca líneas[i]
                fila++
                i++
            }
        }
        _decir(alto - 1, ancho)
        nue = idi::texto("acción.nuevo")
        edi = idi::texto("acción.editar")
        bor = idi::texto("acción.borrar")
        abo = idi::texto("acción.abonar")
        car = idi::texto("acción.cargar")
        tra = idi::texto("acción.traspasar")
        len = idi::nombre_idioma(idi::actual())
        _pie(alto, ancho, "↑↓/jk ▸ n " nue " · e " edi " · x " bor " · + " abo " · - " car " · t " tra " · i " len " · ⏎ ←")
    }

    // Elegir categoría, con los nombres en el idioma activo y las
    // CLAVES devueltas: lo que se guarda es la clave.
    // EN: pick a category — names in the active locale, KEYS
    // returned, since the key is what gets stored.
    _elegir_categoría(fila) {
        cats = al::categorías_anotables()
        ? cats$# == 0 { <~ (#0, 0) }
        etiquetas = []
        // La marca es el SENTIDO de la categoría, no su
        // naturaleza: `+` abona, `−` carga.
        // EN: the mark is the category's sentido, not its nature.
        @ c:cats {
            marca = "−"
            ? c.sentido == "abono" { marca = "+" }
            etiquetas = °etiquetas$+ (marca " " idi::categoría(c.clave))
        }
        (ok, cual) = cp::elegir(fila, 3, 34, etiquetas, idi::texto("msg.elige_categoría") ":")
        ? !ok { <~ (#0, 0) }
        <~ (#1, cats[cual])
    }

    _nuevo(cuenta, alto, ancho) {
        >>!
        _encabezado(ancho)
        >>~ (3, 3, 1, TÍTULO, 0) > idi::texto("acción.nuevo")

        (okc, cat) = _elegir_categoría(5)
        ? !okc { <~ #0 }

        m = mon::obtener(cuenta.moneda)
        (okm, importe) = cp::número(6, 3, 14, m, idi::texto("campo.importe") ":")
        ? !okm { <~ #0 }

        (okg, glosa) = cp::texto(8, 3, 30, idi::texto("campo.glosa") ":", "")
        ? !okg { <~ #0 }

        // El signo lo pone el SENTIDO de la categoría, no quien
        // teclea. Por eso el campo no acepta el signo menos: un
        // cargo es negativo porque es un cargo.
        // EN: the sign comes from the category's SENTIDO, which is
        // why the field does not accept a minus at all.
        final = importe
        ? cat.sentido == "cargo" {
            ? importe > 0 { final = 0 - importe }
        }
        (hecho, _err) = al::anotar(al::hoy(), cuenta.id, cat.id, final, glosa)
        ? !hecho {
        // `_err` se descarta a propósito, y duele. Un error blando
        // no se puede llevar a texto (BUG-ZYB-003), así que no se
        // puede recortar —`term::truncate` lo rechaza— ni medir ni
        // componer con nada. `>>~` sí lo imprime, pero entero y en
        // varias líneas, con el texto crudo del controlador ODBC,
        // que en una pantalla completa destroza la disposición. Así
        // que la interfaz enseña un mensaje suyo y el motivo real se
        // pierde. En una TUI el hueco no es incómodo: es que el
        // error NO SE PUEDE ENSEÑAR.
        //
        // EN: `_err` is deliberately dropped, and it hurts. A soft
        // error cannot be turned into text (BUG-ZYB-003), so it
        // cannot be truncated (`term::truncate` refuses it), measured
        // or composed. `>>~` does print it — whole, multi-line, in
        // the ODBC driver's own words — which wrecks a full-screen
        // layout. So the interface shows a message of its own and the
        // real reason is lost. In a TUI this gap is not awkward: the
        // error CANNOT BE SHOWN.

            aviso = idi::texto("msg.importe_inválido")
            <~ #0
        }
        aviso = idi::texto("msg.anotado") ": " din::formatear(final, m) " " idi::categoría(cat.clave)
        <~ #1
    }

    // El sentido llega como la palabra —"abono" o "cargo"— y no
    // como un 1 o un −1. El signo es su consecuencia aritmética,
    // no su nombre, y una función que recibe −1 no dice qué está
    // haciendo con él.
    // EN: the sentido arrives as the word — "abono" or "cargo" —
    // not as 1 or −1. The sign is its arithmetic consequence, not
    // its name.
    _ajuste(cuenta, sentido, alto, ancho) {
        >>!
        _encabezado(ancho)
        etiqueta = idi::texto("acción.abonar")
        ? sentido == "cargo" { etiqueta = idi::texto("acción.cargar") }
        >>~ (3, 3, 1, TÍTULO, 0) > etiqueta

        m = mon::obtener(cuenta.moneda)
        (okm, importe) = cp::número(5, 3, 14, m, idi::texto("campo.importe") ":")
        ? !okm { <~ #0 }
        (okg, glosa) = cp::texto(7, 3, 30, idi::texto("campo.glosa") ":", "")
        ? !okg { <~ #0 }

        final = importe
        ? sentido == "cargo" { final = 0 - importe }
        (hecho, _err) = al::ajustar(al::hoy(), cuenta.id, final, glosa)
        ? !hecho {
            aviso = idi::texto("msg.importe_inválido")
            <~ #0
        }
        aviso = etiqueta ": " din::formatear(final, m)
        <~ #1
    }

    // ── Traspasar entre cuentas ──────────────────────────────
    //
    // Un traspaso NO es un gasto en una cuenta y un ingreso en la
    // otra. Es UN asiento de DOS partidas —cargo en el origen, abono
    // en el destino— que viven o mueren juntas, sin categoría y
    // emparejadas por una marca. Por eso no pasa por `_nuevo` ni pide
    // categoría: el dinero no sale del patrimonio, solo cambia de
    // sitio, y contarlo como gasto e ingreso inflaría las dos
    // columnas del resumen a la vez. `resumen_por_categoría` los
    // excluye por eso mismo.
    //
    // Las monedas distintas no se convierten con una tasa inventada:
    // se PIDE el importe que llega. Quien mueve 100 USD a una cuenta
    // en pesos sabe a cuánto se los cambiaron; el programa no, y
    // adivinarlo sería falsificar un asiento.
    //
    // EN: a transfer is not an expense in one account and an income
    // in the other. It is ONE entry of TWO legs — debit at the
    // source, credit at the destination — living or dying together,
    // categoryless and paired by a mark; counting it as expense and
    // income would inflate both columns of the summary at once.
    // Across currencies the destination amount is ASKED FOR, never
    // derived from an invented rate.
    _traspaso(origen, alto, ancho) {
        // El origen se quita de la lista ANTES de enseñarla, en vez
        // de rechazarlo después: una opción que no se puede elegir
        // no se ofrece.
        // EN: the source is removed from the list before showing it,
        // rather than refused afterwards.
        destinos = []
        @ c:al::cuentas() {
            ? c.id <> origen.id { destinos = °destinos$+ c }
        }
        ? destinos$# == 0 {
            aviso = idi::texto("msg.falta_otra_cuenta")
            <~ #0
        }

        >>!
        _encabezado(ancho)
        mo = mon::obtener(origen.moneda)
        >>~ (3, 3, 1, TÍTULO, 0) > idi::texto("acción.traspasar") "  " origen.nombre "  " din::formatear(al::saldo(origen.id), mo)

        etiquetas = []
        @ d:destinos {
            etiquetas = °etiquetas$+ (d.nombre "  " d.moneda)
        }
        (okd, cual) = cp::elegir(5, 3, 34, etiquetas, idi::texto("campo.cuenta") ":")
        ? !okd { <~ #0 }
        destino = destinos[cual]
        md = mon::obtener(destino.moneda)

        // `elegir` ocupa su fila y una por opción; la siguiente libre
        // es esa cuenta hecha.
        // EN: `elegir` uses its own row plus one per option.
        fila = 6 + destinos$#

        (oko, importe_o) = cp::número(fila, 3, 14, mo, idi::texto("campo.importe") " " origen.moneda ":")
        ? !oko { <~ #0 }

        importe_d = importe_o
        fila_glosa = fila + 2
        ? origen.moneda <> destino.moneda {
            >>~ (fila + 1, 3, 0, AVISO, 0) > idi::texto("msg.moneda_distinta")
            (okv, v) = cp::número(fila + 2, 3, 14, md, idi::texto("campo.importe") " " destino.moneda ":")
            ? !okv { <~ #0 }
            importe_d = v
            fila_glosa = fila + 4
        }

        (okg, glosa) = cp::texto(fila_glosa, 3, 30, idi::texto("campo.glosa") ":", "")
        ? !okg { <~ #0 }

        (hecho, _err) = al::traspasar(al::hoy(), origen.id, destino.id, importe_o, importe_d, glosa)
        ? !hecho {
            // `_err` se descarta por lo mismo que en `_nuevo`: un
            // error blando no se puede llevar a texto (BUG-ZYB-003).
            // EN: `_err` is dropped for the reason given in `_nuevo`.
            aviso = idi::texto("msg.importe_inválido")
            <~ #0
        }
        aviso = idi::texto("msg.traspasado") ": " din::formatear(importe_o, mo) " → " din::formatear(importe_d, md) "  " destino.nombre
        <~ #1
    }

    _editar(cuenta, mv, alto, ancho) {
        // Las dos partidas de un traspaso no se editan: cada una es
        // la mitad de un solo asiento, y cambiar una mitad deja la
        // otra mintiendo. Se dice y no se abre el formulario.
        // EN: the legs of a transfer are not editable — changing one
        // half leaves the other lying. Say so, do not open the form.
        ? !al::es_nulo(mv.traspaso) {
            aviso = idi::texto("msg.traspaso_fijo")
            <~ #0
        }
        >>!
        _encabezado(ancho)
        >>~ (3, 3, 1, TÍTULO, 0) > idi::texto("acción.editar") "  " mv.fecha

        m = mon::obtener(cuenta.moneda)
        (okm, importe) = cp::número(5, 3, 14, m, idi::texto("campo.importe") ":")
        ? !okm { <~ #0 }
        (okg, glosa) = cp::texto(7, 3, 30, idi::texto("campo.glosa") ":", mv.glosa)
        ? !okg { <~ #0 }

        cat_id = 0
        sentido = "cargo"
        ? !al::es_nulo(mv.categoría) {
            c = al::categoría_por_clave(mv.categoría)
            ? !al::es_nulo(c) {
                cat_id = c.id
                sentido = c.sentido
            }
        }
        final = importe
        ? sentido == "cargo" {
            ? importe > 0 { final = 0 - importe }
        }
        (hecho, _err) = al::actualizar(mv.id, mv.fecha, cat_id, final, glosa)
        ? !hecho {
            aviso = idi::texto("msg.traspaso_fijo")
            <~ #0
        }
        aviso = idi::texto("msg.actualizado") ": " din::formatear(final, m)
        <~ #1
    }

    _borrar(mv, alto, ancho) {
        sí = cp::confirmar(alto - 2, 3, idi::texto("msg.confirmar_borrado"))
        ? !sí {
            aviso = idi::texto("msg.cancelado")
            <~ #0
        }
        (hecho, qué) = al::borrar(mv.id)
        ? !hecho {
            aviso = idi::texto("msg.cancelado")
            <~ #0
        }
        aviso = idi::texto("msg.borrado")
        ? qué == "traspaso_completo" {
            aviso = idi::texto("msg.borrado") " · " idi::texto("acción.traspasar")
        }
        <~ #1
    }

    // ── Resumen ──────────────────────────────────────────────

    _pintar_resumen(cuenta_id, alto, ancho) {
        >>!
        _encabezado(ancho)
        >>~ (2, 3, 1, TÍTULO, 0) > idi::texto("menú.resumen")

        r = al::resumen_por_categoría(cuenta_id, "0000-01-01", "9999-12-31")
        ? r$# == 0 {
            >>~ (4, 3, 0, TEXTO, 0) > idi::texto("msg.sin_movimientos")
        }
        _ {
            enc = [idi::texto("campo.moneda"), idi::texto("campo.categoría"),
                   idi::texto("campo.total"), idi::texto("campo.cuantos")]
            filas = []
            totales = []
            @ f:r {
                m = mon::obtener(f.moneda)
                cuantos = "" f.cuantos
                filas = °filas$+ [f.moneda, idi::categoría(f.categoría),
                                  din::formatear(f.total, m), cuantos]
                totales = °totales$+ f.total
            }
            líneas = tab::componer(enc, filas, ["izq", "izq", "der", "der"])
            fila = 4
            i = 1
            @ i <= líneas$# {
                color = TENUE
                ? i > 2 { color = _color_de(totales[i - 2]) }
                >>~ (fila, 3, 0, color, 0) > líneas[i]
                fila++
                i++
            }
        }
        _decir(alto - 1, ancho)
        len = idi::nombre_idioma(idi::actual())
        _pie(alto, ancho, "r ← · i " len " · q " idi::texto("menú.salir"))
    }

    // ── El bucle ─────────────────────────────────────────────

    correr() {
        >>| {
            sel = 1
            sel_mov = 1
            vista = "cuentas"
            abierta = 0

            @:principal {
                (alto, ancho) = >>?
                cuentas = al::cuentas()
                ? sel > cuentas$# { sel = cuentas$# }
                ? sel < 1 { sel = 1 }

                caben = alto - 8
                ? caben < 1 { caben = 1 }
                cuenta = #0
                movs = []
                ? vista == "movimientos" {
                    ? abierta > 0 {
                        cuenta = al::cuenta(abierta)
                        movs = _movs_de(cuenta, caben)
                        ? sel_mov > movs$# { sel_mov = movs$# }
                        ? sel_mov < 1 { sel_mov = 1 }
                    }
                }

                ?? vista {
                    "movimientos" => { _pintar_movimientos(cuenta, movs, sel_mov, alto, ancho) }
                    "resumen"     => { _pintar_resumen(abierta, alto, ancho) }
                    _             => { _pintar_cuentas(cuentas, sel, alto, ancho) }
                }
                aviso = ""

                <<| t

                ? t == 'q' || t == 'Q' {
                    @! principal
                }
                // ← vuelve, igual que ESC: es la misma acción y la
                // flecha es la que busca quien no conoce el pie.
                // EN: ← goes back, like ESC.
                ? k::es_escapar(t) || k::es_izquierda(t) {
                    ? vista <> "cuentas" { vista = "cuentas" }
                }
                ? t == 'i' || t == 'I' {
                    _rotar_idioma()
                }
                ? t == 'r' || t == 'R' {
                    ? vista == "resumen" { vista = "cuentas" }
                    _ { vista = "resumen" }
                }
                // → entra, igual que ⏎.
                // EN: → opens, like ⏎.
                ? k::es_entrar(t) || k::es_derecha(t) {
                    ? vista == "cuentas" {
                        ? cuentas$# > 0 {
                            abierta = cuentas[sel].id
                            sel_mov = 1
                            vista = "movimientos"
                        }
                    }
                    _ { vista = "cuentas" }
                }
                // Bajar y subir, con la flecha o con `j`/`k`. Las
                // dos formas y no una: el pie enseñaba solo `jk` y
                // la primera reacción de quien abre la aplicación es
                // pulsar la flecha, que no hacía nada — una lista
                // que no responde a ↓ parece una lista rota, no una
                // lista con otro convenio.
                // EN: down and up, by arrow or by `j`/`k`. Both, not
                // one: the footer showed only `jk`, and the first
                // thing anyone does is press the arrow, which did
                // nothing — a list that ignores ↓ looks broken, not
                // like a list with a different convention.
                ? t == 'j' || k::es_abajo(t) {
                    ? vista == "movimientos" {
                        ? sel_mov < movs$# { sel_mov++ }
                    }
                    _ {
                        ? sel < cuentas$# { sel++ }
                    }
                }
                ? t == 'k' || k::es_arriba(t) {
                    ? vista == "movimientos" {
                        ? sel_mov > 1 { sel_mov-- }
                    }
                    _ {
                        ? sel > 1 { sel-- }
                    }
                }
                ? t == 'c' || t == 'C' {
                    ? vista == "cuentas" { _cuenta_nueva(alto, ancho) }
                }
                // El origen es la cuenta que se está mirando, en las
                // dos vistas: en la lista, la señalada; dentro, la
                // abierta. Preguntar por el origen cuando ya está en
                // pantalla sería preguntar por lo que el usuario
                // acaba de señalar.
                // EN: the source is the account being looked at, in
                // both views — the marked one in the list, the open
                // one inside.
                ? t == 't' || t == 'T' {
                    ? vista == "cuentas" {
                        ? cuentas$# > 0 { _traspaso(cuentas[sel], alto, ancho) }
                    }
                    ? vista == "movimientos" {
                        ? abierta > 0 { _traspaso(cuenta, alto, ancho) }
                    }
                }
                ? t == 'n' || t == 'N' {
                    ? vista == "movimientos" { _nuevo(cuenta, alto, ancho) }
                }
                ? t == '+' {
                    ? vista == "movimientos" { _ajuste(cuenta, "abono", alto, ancho) }
                }
                ? t == '-' {
                    ? vista == "movimientos" { _ajuste(cuenta, "cargo", alto, ancho) }
                }
                ? t == 'e' || t == 'E' {
                    ? vista == "movimientos" {
                        ? movs$# > 0 { _editar(cuenta, movs[sel_mov], alto, ancho) }
                    }
                }
                ? t == 'x' || t == 'X' {
                    ? vista == "movimientos" {
                        ? movs$# > 0 { _borrar(movs[sel_mov], alto, ancho) }
                    }
                }
            }
        }
        >>!
        <~ 0
    }
}
