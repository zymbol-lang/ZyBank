// ============================================================
// idioma/english.zy — English (en).
//
// The keys stay Spanish because the program is written in Spanish.
// A key is a concept in the base language, not a neutral ASCII
// identifier, and translating the keys would only move the problem.
//
// Contrato: código · nombre · pares. El catálogo se escribe como
// lista de pares y núcleo/mapa.zy lo vuelve diccionario; el porqué
// está allí.
//
// EN: English locale. Keys stay Spanish — a key is a concept in
// the base language, not a neutral identifier.
// ============================================================

# .idioma_english {

    #> { código, nombre, pares }

    código() { <~ "en" }
    nombre() { <~ "English" }

    pares() {
        <~ [
            ("app.nombre",             "ZyBank"),
            ("app.lema",               "Income and expenses"),

            ("menú.cuentas",           "Accounts"),
            ("menú.movimientos",       "Movements"),
