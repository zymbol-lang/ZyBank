            ("msg.importe_inválido",   "That amount is not valid for this currency"),
            ("msg.cuenta_no_existe",   "No such account"),
            ("msg.misma_cuenta",       "Source and destination are the same account"),
            ("msg.falta_otra_cuenta",  "A transfer needs a second account"),
            ("msg.moneda_distinta",    "The accounts use different currencies: give the destination amount"),
            ("msg.creado",             "Created"),
            ("msg.anotado",            "Recorded"),
            ("msg.traspasado",         "Transferred"),

            ("info.abonos",            "Credits"),
            ("info.cargos",            "Debits"),
