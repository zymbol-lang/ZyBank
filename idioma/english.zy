            ("grupo.ajuste",           "Adjustments"),
            ("grupo.apertura",         "Openings"),

            ("cat.ingreso.sueldo",     "Salary"),
            ("cat.ingreso.honorarios", "Fees"),
            ("cat.ingreso.intereses",  "Interest"),
            ("cat.ingreso.regalo",     "Gift"),
            ("cat.gasto.alimentación", "Food"),
            ("cat.gasto.vivienda",     "Housing"),
            ("cat.gasto.servicios",    "Utilities"),
            ("cat.gasto.transporte",   "Transport"),
            ("cat.gasto.salud",        "Health"),
            ("cat.gasto.educación",    "Education"),
            ("cat.gasto.ocio",         "Leisure"),
            ("cat.gasto.impuestos",    "Taxes"),
            ("cat.ajuste.abono",       "Adjustment (credit)"),
            ("cat.ajuste.cargo",       "Adjustment (debit)"),
            ("cat.apertura.abono",     "Opening (credit)"),
            ("cat.apertura.cargo",     "Opening (debit)"),

