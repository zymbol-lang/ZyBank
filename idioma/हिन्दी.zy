// ============================================================
// idioma/हिन्दी.zy — हिन्दी (hi).
//
// Este idioma trae además la tercera vía de i18n: elegirlo cambia
// la ESCRITURA DE LAS CIFRAS a devanagari (`#०९#`), sin una sola
// entrada de catálogo por número. El despachador lo hace al fijar
// el idioma; aquí no hay nada que decir al respecto, y esa es
// justamente la propiedad.
//
// Contrato: código · nombre · pares. El catálogo se escribe como
// lista de pares y núcleo/mapa.zy lo vuelve diccionario; el porqué
// está allí.
//
// EN: Hindi locale. Choosing it also switches the DIGIT SCRIPT to
// Devanagari (`#०९#`) with no catalogue entry per number — the
// dispatcher does it when setting the locale, and there is nothing
// to say about it here, which is exactly the property.
// ============================================================

# .idioma_हिन्दी {

    #> { código, nombre, pares }

    código() { <~ "hi" }
    nombre() { <~ "हिन्दी" }

    pares() {
        <~ [
            ("app.nombre",             "ZyBank"),
            ("app.lema",               "आय और व्यय"),

            ("menú.cuentas",           "खाते"),
            ("menú.movimientos",       "लेनदेन"),
            ("menú.resumen",           "सारांश"),
            ("menú.configuración",     "सेटिंग"),
            ("menú.salir",             "बाहर"),

            ("campo.fecha",            "दिनांक"),
            ("campo.cuenta",           "खाता"),
            ("campo.categoría",        "श्रेणी"),
            ("campo.monto",            "राशि"),
            ("campo.glosa",            "विवरण"),
            ("campo.saldo",            "शेष"),
            ("campo.moneda",           "मुद्रा"),
            ("campo.total",            "कुल"),
            ("campo.cuantos",          "संख्या"),

            ("tipo.ingreso",           "आय"),
            ("tipo.gasto",             "व्यय"),

            ("grupo.ingreso.trabajo",  "कार्य"),
            ("grupo.ingreso.otros",    "अन्य आय"),
            ("grupo.gasto.hogar",      "घर"),
            ("grupo.gasto.personal",   "व्यक्तिगत"),
            ("grupo.gasto.deberes",    "दायित्व"),

            ("cat.ingreso.sueldo",     "वेतन"),
            ("cat.ingreso.honorarios", "पारिश्रमिक"),
            ("cat.ingreso.intereses",  "ब्याज"),
            ("cat.ingreso.regalo",     "उपहार"),
            ("cat.gasto.alimentación", "भोजन"),
            ("cat.gasto.vivienda",     "आवास"),
            ("cat.gasto.servicios",    "सेवाएँ"),
            ("cat.gasto.transporte",   "परिवहन"),
            ("cat.gasto.salud",        "स्वास्थ्य"),
            ("cat.gasto.educación",    "शिक्षा"),
            ("cat.gasto.ocio",         "मनोरंजन"),
            ("cat.gasto.impuestos",    "कर"),

            ("acción.anotar",          "दर्ज"),
            ("acción.listar",          "सूची"),
            ("acción.traspasar",       "स्थानांतरण"),
            ("acción.resumir",         "सारांश"),

            ("msg.sin_movimientos",    "कोई लेनदेन नहीं"),
            ("msg.sin_cuentas",        "अभी कोई खाता नहीं"),
            ("msg.monto_inválido",     "इस मुद्रा के लिए राशि मान्य नहीं है"),
            ("msg.cuenta_no_existe",   "ऐसा कोई खाता नहीं"),
            ("msg.misma_cuenta",       "स्रोत और गंतव्य एक ही खाता है"),
            ("msg.moneda_distinta",    "खातों की मुद्राएँ भिन्न हैं: गंतव्य राशि बताएं"),
            ("msg.creado",             "बनाया"),
            ("msg.anotado",            "दर्ज किया"),
            ("msg.traspasado",         "स्थानांतरित"),

            ("info.entradas",          "आवक"),
            ("info.salidas",           "जावक"),
            ("info.neto",              "शुद्ध"),
            ("info.periodo",           "अवधि")
        ]
    }
}
