            ("grupo.gasto.hogar",      "घर"),
            ("grupo.gasto.personal",   "व्यक्तिगत"),
            ("grupo.gasto.deberes",    "दायित्व"),
            ("grupo.ajuste",           "समायोजन"),
            ("grupo.apertura",         "प्रारंभिक"),

            ("cat.ingreso.sueldo",     "वेतन"),
            ("cat.ingreso.honorarios", "पारिश्रमिक"),
            ("cat.ingreso.intereses",  "ब्याज"),
            ("cat.ingreso.regalo",     "उपहार"),
            ("cat.gasto.alimentación", "भोजन"),
            ("cat.gasto.vivienda",     "आवास"),
            ("cat.gasto.servicios",    "सेवाएँ"),
