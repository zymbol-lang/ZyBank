// ============================================================
// idioma/हिन्दी.zy — हिन्दी (hi).
//
// Este idioma trae además la tercera vía de i18n: elegirlo cambia
// la ESCRITURA DE LAS CIFRAS a devanagari (`#०९#`), sin una sola
// entrada de catálogo por número. El despachador lo hace al fijar
// el idioma; aquí no hay nada que decir al respecto, y esa es
// justamente la propiedad.
//
// Contrato: código · nombre · pares. El catálogo se escribe como
// lista de pares y núcleo/mapa.zy lo vuelve diccionario; el porqué
// está allí.
//
// EN: Hindi locale. Choosing it also switches the DIGIT SCRIPT to
// Devanagari (`#०९#`) with no catalogue entry per number — the
// dispatcher does it when setting the locale, and there is nothing
// to say about it here, which is exactly the property.
// ============================================================

# .idioma_हिन्दी {

    #> { código, nombre, pares }

    código() { <~ "hi" }
    nombre() { <~ "हिन्दी" }

    pares() {
        <~ [
            ("app.nombre",             "ZyBank"),
            ("app.lema",               "आय और व्यय"),

            ("menú.cuentas",           "खाते"),
            ("menú.movimientos",       "लेनदेन"),
            ("menú.resumen",           "सारांश"),
            ("menú.configuración",     "सेटिंग"),
            ("menú.salir",             "बाहर"),

            ("campo.fecha",            "दिनांक"),
            ("campo.cuenta",           "खाता"),
            ("campo.categoría",        "श्रेणी"),
            ("campo.importe",          "राशि"),
            ("campo.glosa",            "विवरण"),
            ("campo.saldo",            "शेष"),
            ("campo.moneda",           "मुद्रा"),
