            ("cat.apertura.abono",     "प्रारंभिक शेष (जमा)"),
            ("cat.apertura.cargo",     "प्रारंभिक शेष (नामे)"),

            ("acción.anotar",          "दर्ज"),
            ("acción.listar",          "सूची"),
            ("acción.traspasar",       "स्थानांतरण"),
